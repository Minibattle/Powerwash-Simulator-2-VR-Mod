<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build on Windows with the game installed and launched once with MelonLoader
       (that first launch generates MelonLoader\Il2CppAssemblies):

         dotnet build -c Release -p:GamePath="E:\SteamLibrary\steamapps\common\PowerWash Simulator 2"

       The DLL lands in bin\Release\net6.0\PowerWashVR.dll; copy it to <game>\Mods. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>11</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=./</PathMap>
    <Version>2.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\PowerWash Simulator 2</GamePath>
    <ML>$(GamePath)\MelonLoader\net6</ML>
    <Interop>$(GamePath)\MelonLoader\Il2CppAssemblies</Interop>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build\**;out\**;package\**;bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ML)\0Harmony.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(ML)\MelonLoader.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppFuturLab.PW2.Core.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppFuturLab.PW2.GFX.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppFuturLab.PW2.GameContent.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppFuturLab.PW2.SaveData.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppFuturLab.PW2.UI.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppFuturLab.PW2.TexturePainter.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppFuturLab.PW2.VFX.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppFuturLab.PW2.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppFuturLab.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppSystem.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppVLB.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.Addressables.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.Collections.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.Localization.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.Netcode.Runtime.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.RenderPipelines.GPUDriven.Runtime.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.SubsystemsModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.TerrainModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIElementsModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.VRModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.XRModule.dll" Private="false" />
  </ItemGroup>
</Project>
